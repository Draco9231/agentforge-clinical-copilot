{
	"name": "copilot-agent",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "node --experimental-strip-types --experimental-loader ./scripts/ts-resolve-loader.mjs --test src/*.test.ts",
