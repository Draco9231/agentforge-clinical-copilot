	},
	"dependencies": {
		"@langchain/core": "^1.2.12",
		"@langchain/langgraph": "^1.4.17",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"typescript": "^5.5.2",
		"wrangler": "^4"
	}
}
